# Required
DISCORD_TOKEN=
CLIENT_ID=
MONGO_URI=

# Optional
# Register slash commands for this server only (instant updates). Leave empty for global commands.
GUILD_ID=
# Set to false to stop syncing slash commands on every start (use "npm run deploy" instead)
AUTO_DEPLOY=true
# Default store name used on embeds (can be changed with /setup store)
STORE_NAME=Our Store
# Prefix for text commands (comma separated for several, e.g. !,?)
PREFIX=!
# Bot status text ("Watching ...")
DEFAULT_STATUS=your orders | /help
